# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Virtual environments ---
.venv/
venv/
env/
.conda/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Run outputs & logs (regenerated by src/benchmark.py) ---
results/*
!results/.gitkeep
logs/
*.log

# --- Data: the 8-row sample (Task 2) and the Task 3 survey log + aggregates are versioned ---
data/raw/*
!data/raw/.gitkeep
!data/raw/test_run.jsonl
data/processed/*
!data/processed/metrics_summary.csv
*.xlsx
*.sav
*.parquet
*.zip

# --- Secrets ---
.env
*.key
*.pem
credentials*.json

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
